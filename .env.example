# Copy to .env.cms before starting the CMS overlay. Do not commit .env.cms.
CMS_DB_NAME=firefly_cms
CMS_DB_USER=firefly
CMS_DB_PASSWORD=replace-with-a-long-random-password
CMS_ADMIN_EMAIL=admin@example.com
CMS_ADMIN_PASSWORD=replace-with-a-long-random-password
DIRECTUS_KEY=replace-with-a-random-32-character-key
DIRECTUS_SECRET=replace-with-a-random-32-character-secret
CMS_PUBLIC_URL=https://blog.ycocc.com
DIRECTUS_SERVICE_TOKEN=replace-with-a-directus-static-token
PUBLISHER_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
CONTENT_REPOSITORY=https://github.com/a67164614/sc-blog.git
GIT_AUTHOR_NAME=Sc Blog CMS
GIT_AUTHOR_EMAIL=cms@example.com
GITHUB_TOKEN=replace-with-a-github-fine-grained-token
GITHUB_BRANCH=main
GITHUB_API_URL=https://api.github.com
